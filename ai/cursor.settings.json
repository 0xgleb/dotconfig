{
  "permissions": {
    "allow": [
      "Shell(cargo)",
      "Shell(bun)",
      "Shell(sqlx)",
      "Shell(gt)",
      "Shell(git)",
      "Shell(pre-commit)",
      "Shell(gh)",
      "Shell(ls)",
      "Shell(find)",
      "Shell(grep)",
      "Shell(rg)",
      "Shell(bat)",
      "Shell(cat)",
      "Shell(darwin-rebuild build:*)",
      "Shell(linear)",
      "Shell(head)",
      "Shell(echo)",
      "Shell(which)",
      "Shell(type)",
      "Shell(command)",
      "Shell(mkdir)",
      "WebFetch(docs.rs)",
      "WebFetch(github.com)",
      "WebFetch(*.github.com)"
    ],
    "deny": [
      "Shell(darwin-rebuild switch:*)",
      "Shell(git checkout master:*)",
      "Shell(git stash:*)",
      "Shell(sed)",
      "Shell(sudo)",
      "Read(.env*)",
      "Write(.env*)",
      "Write(**/*.key)"
    ]
  },
  "editor": {
    "vimMode": true
  },
  "approvalMode": "allowlist",
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "attribution": {
    "attributeCommitsToAgent": true,
    "attributePRsToAgent": true
  },
  "notifications": true,
  "hints": true
}
