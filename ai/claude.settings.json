{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo fix:*)",
      "Bash(cargo add:*)",
      "Bash(bun add:*)",
      "Bash(bun run:*)",
      "Bash(sqlx db create:*)",
      "Bash(sqlx migrate add:*)",
      "Bash(gt ls:*)",
      "Bash(gt ls-files:*)",
      "Bash(gt ls-tree:*)",
      "Bash(gt restack:*)",
      "Bash(git add:*)",
      "Bash(pre-commit run:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git ls-tree:*)",
      "Bash(git grep:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(bat:*)",
      "Bash(cat:*)",
      "Bash(darwin-rebuild build:*)",
      "WebSearch",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(darwin-rebuild switch:*)",
      "Bash(git checkout master:*)",
      "Bash(git stash:*)",
      "Bash(sed:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); tokens=$(echo \"$input\" | jq -r '.context_window.current_usage.input_tokens // empty'); [ -z \"$tokens\" ] && exit 0; k=$((tokens / 1000)); echo \"~t${k}k\""
  },
  "enabledPlugins": {},
  "effortLevel": "medium",
  "fastMode": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
