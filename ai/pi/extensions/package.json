{
  "name": "local-pi-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write --no-error-on-unmatched-pattern --config ../../../prettier.config.mjs ../../../ai/**/*.{ts,tsx,mts,cts}",
    "format:check": "prettier --check --no-error-on-unmatched-pattern --config ../../../prettier.config.mjs ../../../ai/**/*.{ts,tsx,mts,cts}",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "pi-package"
  ],
  "dependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@earendil-works/pi-tui": "0.84.1",
    "babel-preset-solid": "1.9.12",
    "effect": "3.22.0",
    "solid-js": "1.9.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./activity-status/index.ts",
      "./agent-registry/index.ts",
      "./agent-workspace/index.ts",
      "./auto-reload/index.ts",
      "./classified-workflows/index.ts",
      "./browser-control/index.ts",
      "./btw/index.ts",
      "./compact-footer/index.ts",
      "./compact-read/index.ts",
      "./disk-pressure/index.ts",
      "./input-ergonomics/index.ts",
      "./nushell-default/index.ts",
      "./image-summary/index.ts",
      "./link-safety/index.ts",
      "./local-models/index.ts",
      "./pi-vim/index.ts",
      "./questions/index.ts",
      "./release-cadence/index.ts",
      "./request-observability/index.ts",
      "./remote-control/index.ts",
      "./safe-compaction/index.ts",
      "./todo/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.12.4",
    "prettier": "3.8.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
