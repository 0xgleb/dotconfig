+/**
+ * Read enough of a session to recover its immutable header and newest messages
+ * without turning an unbounded, long-running JSONL file into one V8 string.
+ * Live indexing already writes recent messages idempotently; startup backfill
+ * only needs a bounded tail to reconcile messages missed around shutdown.
+ */
+function readBoundedSessionText(filePath: string): string {
+  const fd = fs.openSync(filePath, 'r');
+  try {
+    const size = fs.fstatSync(fd).size;
+    if (size <= MAX_SESSION_TAIL_READ_BYTES) {
+      return fs.readFileSync(fd, 'utf-8');
+    }
+
+    const headerBytes = Math.min(size, MAX_SESSION_HEADER_READ_BYTES);
+    const header = Buffer.allocUnsafe(headerBytes);
+    const headerRead = fs.readSync(fd, header, 0, headerBytes, 0);
+    const headerText = header.subarray(0, headerRead).toString('utf-8');
+    const headerBoundary = headerText.indexOf('\n');
+    const sessionHeader = headerBoundary >= 0
+      ? headerText.slice(0, headerBoundary)
+      : headerText;
+
+    const tailBytes = Math.min(size, MAX_SESSION_TAIL_READ_BYTES);
+    const tailOffset = size - tailBytes;
+    const tail = Buffer.allocUnsafe(tailBytes);
+    const tailRead = fs.readSync(fd, tail, 0, tailBytes, tailOffset);
+    const tailText = tail.subarray(0, tailRead).toString('utf-8');
+    const firstBoundary = tailText.indexOf('\n');
+    const completeTail = firstBoundary >= 0
+      ? tailText.slice(firstBoundary + 1)
+      : '';
+
+    return `${sessionHeader}\n${completeTail}`;
+  } finally {
+    fs.closeSync(fd);
+  }
+}
