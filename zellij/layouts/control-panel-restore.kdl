// Full control-panel session layout: one tab, every agent pane resuming its
// existing session. Shape: left stack (grok workers + htop) | st0x Fable
// center 50% | right stack (yielduck Fable, dispatcher, .config Fable), with
// mprocs as a short full-width bottom row.
//
// Hard-won rules encoded here:
//   - absolute cwds only (relative pane cwds resolve against the caller)
//   - project panes launch via `direnv exec .` so flake dev shells load
//     (mprocs comes from yielduck's shell, not the system PATH)
//   - `jf clanker` WITHOUT --new resumes the existing agent sessions
//   - the swap section below replaces zellij's built-in columns/rows pair,
//     which otherwise takes over any session started from a swap-less file
//
// Usage (from a terminal OUTSIDE zellij):
//   zellij kill-session control-panel
//   zellij delete-session control-panel
//   zellij --session control-panel --new-session-with-layout ~/.config/zellij/layouts/control-panel-restore.kdl
layout {
    tab name="work" focus=true {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane split_direction="horizontal" {
            pane size="78%" split_direction="vertical" {
                pane size="25%" split_direction="horizontal" {
                    pane command="/run/current-system/sw/bin/htop" cwd="/Users/0xgleb/.config"
                }
                pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="st0x-fable" cwd="/Users/0xgleb/code/st0x" focus=true size="50%" {
                    args "exec" "." "jf" "clanker" "--claude"
                }
                pane size="25%" split_direction="horizontal" {
                    pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="yielduck-fable" cwd="/Users/0xgleb/code/dataclique/yielduck" {
                        args "exec" "." "jf" "clanker" "--claude"
                    }
                    pane command="/Users/0xgleb/.nix-profile/bin/jf" name="pi-dispatcher" cwd="/Users/0xgleb/.config" {
                        args "clanker" "--dispatcher"
                    }
                    pane command="/Users/0xgleb/.nix-profile/bin/jf" name="config-fable" cwd="/Users/0xgleb/.config" {
                        args "clanker" "--claude"
                    }
                }
            }
            pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="mprocs" cwd="/Users/0xgleb/code/dataclique/yielduck" size="22%" {
                args "exec" "." "mprocs"
            }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // Opus workers drain the project queues. They were absent from this file,
    // so a restore brought back the Fables and the dispatcher while the
    // workers stayed gone - one vanished silently and the rest were relaunched
    // by hand. `--worker` carries the standard drain mandate, so a pane
    // definition cannot drift from what a worker is supposed to be.
    tab name="opus workers" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane split_direction="vertical" {
            pane command="/Users/0xgleb/.nix-profile/bin/jf" name="opus-config" cwd="/Users/0xgleb/.config" {
                args "clanker" "--worker"
            }
            pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="opus-st0x-1" cwd="/Users/0xgleb/code/st0x" {
                args "exec" "." "jf" "clanker" "--worker"
            }
            pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="opus-st0x-2" cwd="/Users/0xgleb/code/st0x" {
                args "exec" "." "jf" "clanker" "--worker"
            }
            pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="opus-yielduck" cwd="/Users/0xgleb/code/dataclique/yielduck" {
                args "exec" "." "jf" "clanker" "--worker"
            }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // Grok research lanes. These previously ran a job-file polling script that
    // has since been retired; they are ordinary /register sessions now, so a
    // restore brings them back onto the roster rather than watching a
    // directory nothing writes to.
    tab name="grok workers" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane split_direction="vertical" {
            pane command="/Users/0xgleb/.nix-profile/bin/cursor-agent" name="grok-config-1" cwd="/Users/0xgleb/.config" {
                args "--model" "grok-4.5-xhigh" "--auto-review" "--workspace" "/Users/0xgleb/.config" "/register 3m You are grok-config-1, a research worker on the .config project. Register on the bridge roster with the agent id grok-config-1. Take only bounded fully-specified research and drafting items. Never push, commit, merge, comment on GitHub, or submit review verdicts. Report outcomes through the dispatcher."
            }
            pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="grok-st0x-1" cwd="/Users/0xgleb/code/st0x" {
                args "exec" "." "cursor-agent" "--model" "grok-4.5-xhigh" "--auto-review" "--workspace" "/Users/0xgleb/code/st0x" "/register 3m You are grok-st0x-1, a research worker on the st0x project. Register on the bridge roster with the agent id grok-st0x-1. Take only bounded fully-specified research and drafting items. Never push, commit, merge, comment on GitHub, or submit review verdicts. Report outcomes through the dispatcher."
            }
            pane command="/Users/0xgleb/.nix-profile/bin/direnv" name="grok-yielduck-1" cwd="/Users/0xgleb/code/dataclique/yielduck" {
                args "exec" "." "cursor-agent" "--model" "grok-4.5-xhigh" "--auto-review" "--workspace" "/Users/0xgleb/code/dataclique/yielduck" "/register 3m You are grok-yielduck-1, a research worker on the yielduck project. Register on the bridge roster with the agent id grok-yielduck-1. Take only bounded fully-specified research and drafting items. Never push, commit, merge, comment on GitHub, or submit review verdicts. Report outcomes through the dispatcher."
            }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab_template name="ui" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    swap_tiled_layout name="columns" {
        ui exact_panes=3 {
            pane split_direction="vertical" {
                pane
                pane size="50%"
                pane
            }
        }
        ui exact_panes=4 {
            pane split_direction="vertical" {
                pane
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }
        ui exact_panes=5 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }
        ui exact_panes=6 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=7 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=8 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }
}
