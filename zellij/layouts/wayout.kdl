layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane
    pane size=1 borderless=true {
        plugin location="status-bar"
    }

    tab_template name="ui" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // ===========================================================================
    // FOCUS COLUMNS  --  the only tiled swap layout (config.kdl default "wayout")
    //
    //   Three columns: a large center pane (50% width) flanked by two stacks.
    //   The N-1 non-center panes split between the stacks, extras going right.
    //     1 = single    2 = two even columns    3 = side | main | side
    //     N>=4 = left stack (floor((N-1)/2)) | main 50% | right stack (rest)
    //   Slot order is left stack top-to-bottom, then main, then right stack:
    //   the pane whose tab-order index lands on the main slot sits center —
    //   swap any pane into the center with move-pane after focusing it.
    //   Alt n  add a pane (rebalances)     Alt e  re-snap after manual drift
    //
    // >>> TO SUPPORT MORE PANES (>16) <<<
    //   Copy the last `ui exact_panes=16` block, bump the number, and add the
    //   extra pane to whichever stack is smaller (right first). Verify with
    //   `zellij setup --check`.
    // ===========================================================================
    swap_tiled_layout name="columns" {
        ui exact_panes=1 {
            pane
        }
        ui exact_panes=2 {
            pane split_direction="vertical" {
                pane
                pane
            }
        }
        ui exact_panes=3 {
            pane split_direction="vertical" {
                pane
                pane size="50%"
                pane
            }
        }
        ui exact_panes=4 {
            pane split_direction="vertical" {
                pane
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }
        ui exact_panes=5 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }
        ui exact_panes=6 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=7 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=8 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=9 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=10 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=11 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=12 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=13 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=14 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=15 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
        ui exact_panes=16 {
            pane split_direction="vertical" {
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
                pane size="50%"
                pane split_direction="horizontal" {
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                    pane
                }
            }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane { y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
