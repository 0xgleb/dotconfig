layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane
    pane size=1 borderless=true {
        plugin location="status-bar"
    }

    tab_template name="ui" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // Default layout: N panes => N even-width columns.
    // Adding/closing a pane (Alt n) auto-rearranges into the matching variant,
    // so columns always stay even. Extend the range by copying the last block.
    swap_tiled_layout name="columns" {
        ui exact_panes=1 {
            pane { children; }
        }
        ui exact_panes=2 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        ui exact_panes=3 {
            pane split_direction="vertical" {
                pane; pane
                pane { children; }
            }
        }
        ui exact_panes=4 {
            pane split_direction="vertical" {
                pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=5 {
            pane split_direction="vertical" {
                pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=6 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=7 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=8 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=9 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=10 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane; pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=11 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=12 {
            pane split_direction="vertical" {
                pane; pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
                pane { children; }
            }
        }
    }

    // Alternate: N panes => N even-height rows.
    // Toggle to/from "columns" with Alt ] / Alt [.
    swap_tiled_layout name="rows" {
        ui exact_panes=1 {
            pane { children; }
        }
        ui exact_panes=2 {
            pane
            pane { children; }
        }
        ui exact_panes=3 {
            pane; pane
            pane { children; }
        }
        ui exact_panes=4 {
            pane; pane; pane
            pane { children; }
        }
        ui exact_panes=5 {
            pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=6 {
            pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=7 {
            pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=8 {
            pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=9 {
            pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=10 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=11 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=12 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane { y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
