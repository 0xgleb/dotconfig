layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane
    pane size=1 borderless=true {
        plugin location="status-bar"
    }

    tab_template name="ui" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // ===========================================================================
    // GRID  --  the default layout (config.kdl sets default_layout "wayout")
    //
    //   Columns are capped at 4 wide. Past 4 panes it wraps to a new row,
    //   filling rows of 4 top-to-bottom:
    //     5 = 4+1   6 = 4+2   7 = 4+3   8 = 4+4
    //     9 = 4+4+1   10 = 4+4+2   11 = 4+4+3   12 = 4+4+4
    //   Alt n          add a pane; it auto-rebalances into the grid
    //   Alt e          re-even now (after a manual split/resize broke the spacing)
    //   Alt ] / Alt [  toggle grid <-> even rows
    //
    // >>> TO SUPPORT MORE PANES (e.g. a 13th, which starts a 4th row) <<<
    //   1. Copy the last `ui exact_panes=12 { ... }` block below.
    //   2. Paste it as the new last block; change 12 -> 13.
    //   3. Grow the LAST row by one cell. A row is
    //      `pane split_direction="vertical" { <bare panes>; <last cell> }`.
    //      When the last row already holds 4, add a whole new row instead.
    //      Rules: every row has <= 4 panes, and the very last cell of the
    //      whole grid is the only `pane { children; }`.
    //   4. Verify: `zellij setup --check`  (must report "Well defined.")
    //
    //   To make columns wider/narrower than 4, change how many panes each row
    //   holds (4 -> 3 or 5) in every variant.
    // ===========================================================================
    swap_tiled_layout name="columns" {
        ui exact_panes=1 {
            pane { children; }
        }
        ui exact_panes=2 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        ui exact_panes=3 {
            pane split_direction="vertical" {
                pane; pane
                pane { children; }
            }
        }
        ui exact_panes=4 {
            pane split_direction="vertical" {
                pane; pane; pane
                pane { children; }
            }
        }
        ui exact_panes=5 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane { children; }
            }
        }
        ui exact_panes=6 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=7 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=8 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane; pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=9 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane { children; }
            }
        }
        ui exact_panes=10 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=11 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=12 {
            pane {
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane; pane; pane
                }
                pane split_direction="vertical" {
                    pane; pane; pane
                    pane { children; }
                }
            }
        }
    }

    // Alternate: N panes => N even-height rows.
    // Toggle to/from "columns" with Alt ] / Alt [.
    swap_tiled_layout name="rows" {
        ui exact_panes=1 {
            pane { children; }
        }
        ui exact_panes=2 {
            pane
            pane { children; }
        }
        ui exact_panes=3 {
            pane; pane
            pane { children; }
        }
        ui exact_panes=4 {
            pane; pane; pane
            pane { children; }
        }
        ui exact_panes=5 {
            pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=6 {
            pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=7 {
            pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=8 {
            pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=9 {
            pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=10 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=11 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=12 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane { y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
