layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane
    pane size=1 borderless=true {
        plugin location="status-bar"
    }

    tab_template name="ui" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // ===========================================================================
    // GRID  --  the default layout (config.kdl sets default_layout "wayout")
    //
    //   Up to 4 even-width columns. Panes 1-4 each open a new column; pane 5+
    //   stack as new rows *within* columns (filling left-to-right), so every
    //   column keeps the same width -- no full-width / double-width panes.
    //     1..4 = one row of N columns
    //     5  = [2,1,1,1]   6  = [2,2,1,1]   7  = [2,2,2,1]   8  = [2,2,2,2]
    //     9  = [3,2,2,2]  10  = [3,3,2,2]  11  = [3,3,3,2]  12  = [3,3,3,3]
    //   Alt n          add a pane; it auto-rebalances into the grid
    //   Alt e          re-even now (after a manual split/resize broke the spacing)
    //   Alt ] / Alt [  toggle grid <-> even rows
    //
    // >>> TO SUPPORT MORE PANES (>12) <<<
    //   Copy the last `ui exact_panes=12 { ... }` block, bump the number, and add
    //   the extra pane to the shortest column (left-to-right). Each of the 4
    //   columns is a `pane { ... }` holding its stacked panes; the very last cell
    //   in the block is the only `pane { children; }`.
    //   To change the 4-column cap, add/remove a column in every variant.
    //   Verify: `zellij setup --check`  (must report "Well defined.")
    // ===========================================================================
    swap_tiled_layout name="columns" {
        ui exact_panes=1 {
            pane { children; }
        }
        ui exact_panes=2 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        ui exact_panes=3 {
            pane split_direction="vertical" {
                pane
                pane
                pane { children; }
            }
        }
        ui exact_panes=4 {
            pane split_direction="vertical" {
                pane
                pane
                pane
                pane { children; }
            }
        }
        ui exact_panes=5 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                }
                pane
                pane
                pane { children; }
            }
        }
        ui exact_panes=6 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane
                pane { children; }
            }
        }
        ui exact_panes=7 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane { children; }
            }
        }
        ui exact_panes=8 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=9 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=10 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                }
                pane {
                    pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=11 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane { children; }
                }
            }
        }
        ui exact_panes=12 {
            pane split_direction="vertical" {
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane
                }
                pane {
                    pane
                    pane
                    pane { children; }
                }
            }
        }
    }

    // Alternate: N panes => N even-height rows.
    // Toggle to/from "columns" with Alt ] / Alt [.
    swap_tiled_layout name="rows" {
        ui exact_panes=1 {
            pane { children; }
        }
        ui exact_panes=2 {
            pane
            pane { children; }
        }
        ui exact_panes=3 {
            pane; pane
            pane { children; }
        }
        ui exact_panes=4 {
            pane; pane; pane
            pane { children; }
        }
        ui exact_panes=5 {
            pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=6 {
            pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=7 {
            pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=8 {
            pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=9 {
            pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=10 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=11 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
        ui exact_panes=12 {
            pane; pane; pane; pane; pane; pane; pane; pane; pane; pane; pane
            pane { children; }
        }
    }

    swap_floating_layout name="staggered" {
        floating_panes
    }

    swap_floating_layout name="enlarged" {
        floating_panes max_panes=10 {
            pane { x "5%"; y 1; width "90%"; height "90%"; }
            pane { x "5%"; y 2; width "90%"; height "90%"; }
            pane { x "5%"; y 3; width "90%"; height "90%"; }
            pane { x "5%"; y 4; width "90%"; height "90%"; }
            pane { x "5%"; y 5; width "90%"; height "90%"; }
            pane { x "5%"; y 6; width "90%"; height "90%"; }
            pane { x "5%"; y 7; width "90%"; height "90%"; }
            pane { x "5%"; y 8; width "90%"; height "90%"; }
            pane { x "5%"; y 9; width "90%"; height "90%"; }
            pane { x 10; y 10; width "90%"; height "90%"; }
        }
    }

    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane { y "50%"; x "50%"; }
        }
        floating_panes max_panes=2 {
            pane { x "1%"; y "25%"; width "45%"; }
            pane { x "50%"; y "25%"; width "45%"; }
        }
        floating_panes max_panes=3 {
            pane { y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; }
            pane { x "50%"; y "1%"; width "45%"; }
        }
        floating_panes max_panes=4 {
            pane { x "1%"; y "55%"; width "45%"; height "45%"; }
            pane { x "50%"; y "55%"; width "45%"; height "45%"; }
            pane { x "1%"; y "1%"; width "45%"; height "45%"; }
            pane { x "50%"; y "1%"; width "45%"; height "45%"; }
        }
    }
}
