#cloud-config
ssh_authorized_keys:
%{ for key in authorized_keys ~}
  - ${key}
%{ endfor ~}

package_update: true
packages:
  - curl
  - xz-utils

runcmd:
  - sh -c 'curl --proto "=https" --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install linux --no-confirm --init systemd'
  - sh -c 'for bin in nix nix-daemon nix-store nix-env nix-build nix-collect-garbage nix-shell; do ln -sf /nix/var/nix/profiles/default/bin/$bin /usr/local/bin/$bin; done'
