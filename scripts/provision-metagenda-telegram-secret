#!/usr/bin/env bash
set -euo pipefail

umask 077
config_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
identity_root="${HOME}/.config/agenix"
identity_path="${identity_root}/metagenda.txt"
rules_path="${config_root}/secrets.nix"
secret_root="${config_root}/secrets"
secret_path="${secret_root}/metagenda-telegram-token.age"

mkdir -p "${identity_root}" "${secret_root}"
if [[ ! -f "${identity_path}" ]]; then
  age-keygen -o "${identity_path}"
fi
recipient="$(age-keygen -y "${identity_path}")"

cat >"${rules_path}" <<RULES
let
  metagenda = "${recipient}";
in
{
  "secrets/metagenda-telegram-token.age".publicKeys = [ metagenda ];
}
RULES

RULES="${rules_path}" ragenix --identity "${identity_path}" --edit "${secret_path}"
printf 'Encrypted Metagenda Telegram token written. Commit only %s and %s; never commit %s.\n' \
  "${rules_path}" "${secret_path}" "${identity_path}"
